Proceso sin_titulo
	definir calor como real;
	definir calor_yankees como real;
	definir kalvin_clain como real;
	
	escribir "dame la temperatura gil";
	leer calor;
	
	calor_yankees= calor*9/5+32;
	kalvin_clain=calor+273.15;
	
	escribir "temperatura en F", calor_yankees;
	escribir "temperatura en k: " , kalvin_clain;

